.DS_Store
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Local crawl output. Keep only empty-directory sentinels in source control.
data/*
!data/.gitkeep
logs/*
!logs/.gitkeep
snapshots/*
!snapshots/.gitkeep
.state.nosync/
runtime

# Proxy files can contain credentials.
proxies.txt
*.proxy
.wrangler/

# Private local evidence for the owner-selected public footer release.
/.fleet-local/precise-footer-release/
